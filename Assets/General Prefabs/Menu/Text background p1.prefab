      m_Calls: []
  m_text: "Carla Cap\xF4 is a streamer from Faro, Portugal. She is a charismatic
    individual and \r\nfrequently tells jokes, one of the many reasons why her fanbase
    stays loyal to her.\r\nCarla has a good connection with her viewers and often
    threatens opponents with sending her army on them, sometimes as a joke and sometimes
    as a serious warning. \r\n\r\nSpecial effects:\r\nHas a Shudder chat.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
