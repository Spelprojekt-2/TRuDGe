  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Andr\xE9 Nuskea, also called Drago\u0219 (by himself), was born in Tulcea,
    Romania. He strives to not listen to anyone but himself and usually has a hard
    time connecting with anyone, even his family. Andr\xE9 was thrown out from home
    after not achieving anything but managed to get back on his feet by winning a
    huge amount of money from a lottery ticket. \r\n\r\nSpecial effects:\r\nAndr\xE9s
    stats (top speed, acceleration, turning speed, friction, etc.) fluctuate randomly
    during the race, simulating a stock market."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
