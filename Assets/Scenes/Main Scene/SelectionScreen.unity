    - target: {fileID: 8044037026975669814, guid: f00f41a79433ed04280b944953b51b56, type: 3}
      propertyPath: m_text
      value: "Andr\xE9 Nuskea, also called Drago\u0219 (by himself), was born in
        Tulcea, Romania. Andr\xE9 was thrown out from home after not achieving anything
        but managed to get back on his feet by winning a huge amount of money from
        a lottery ticket. Now, he continues his life as a 25-year-old tank rally
        racer."
      objectReference: {fileID: 0}
