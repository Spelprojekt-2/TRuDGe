      m_Calls: []
  m_text: "The 51 year old Leonie Arenberg was born in Marburg, Germany. She got
    into racing at a very young age with help from her wealthy parents and managed
    to win a rally world championship in 2028. Leonie's calm attitude and financial
    support to the repair of Schlammrennstrecke makes her a well-known figure in
    racing. \r\n\r\nSpecial effects:\r\nCalm and methodical. \r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
