  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The 36 year old Tristano Martinelli from Tivoli, Italy, has loved performing
    as clowns since he was very young. He worked as a harlequin in commedia dell\u2019arte
    before the war, got drafted as a tank driver during the war and continues his
    performing career today, alongside his dank grifting hobby. Tristano brings his
    harlequin persona out to the track and exposes everyone to the true power (and
    comedy) of the harlequin!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
