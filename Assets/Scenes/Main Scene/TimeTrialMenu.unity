      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3144206202189371698, guid: f00f41a79433ed04280b944953b51b56, type: 3}
      propertyPath: m_LocalEulerAnglesHint.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3144206202189371698, guid: f00f41a79433ed04280b944953b51b56, type: 3}
      propertyPath: m_LocalEulerAnglesHint.z
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3379296185267970313, guid: f00f41a79433ed04280b944953b51b56, type: 3}
      propertyPath: m_Name
      value: King Napoleon VIII description p4
      objectReference: {fileID: 0}
    - target: {fileID: 3659062856983726037, guid: f00f41a79433ed04280b944953b51b56, type: 3}
      propertyPath: m_text
      value: "The 36-year-old Tristano Martinelli from Tivoli, Italy, has loved performing
        as clowns ever since he was a young boy. He worked as a harlequin in commedia
        dell\u2019arte before the war, got drafted as a tank driver during the war
        and continues his performing career today, alongside his dank grifting hobby.
        Tristano brings his harlequin persona out to the track and exposes everyone
        to the true power (and comedy) of the harlequin!\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 4579583393262106183, guid: f00f41a79433ed04280b944953b51b56, type: 3}
      propertyPath: m_text
      value: 'The 30-year-old Lazare Grandetaille was born in Ajaccio, France. Since
        he first began making friends, his pride and need to control situations became
        apparent, which made him lose those friends. When Lazare turned 18, in the
        middle of the war, he pronounced himself King Napoleon VIII in front of an
        almost empty country in order to get the respect he thought he deserved.  '
      objectReference: {fileID: 0}
    - target: {fileID: 4593808385116552617, guid: f00f41a79433ed04280b944953b51b56, type: 3}
      propertyPath: m_Name
      value: "Lars-G\xF6ran description p4"
      objectReference: {fileID: 0}
    - target: {fileID: 5046613660546665568, guid: f00f41a79433ed04280b944953b51b56, type: 3}
      propertyPath: m_text
      value: "Nina Hagen was born 2034 in Dover to an upper class family. After dropping
        out of college she slowly started to disconnect from her parents as she decided
        to walk her own path. When she isn\u2019t rallying she works full-time as
        a mechanic."
      objectReference: {fileID: 0}
    - target: {fileID: 6839170008172661114, guid: f00f41a79433ed04280b944953b51b56, type: 3}
      propertyPath: m_text
      value: "Lars-G\xF6ran is a very competitive 48-year-old individual from Dalarna,
        Sweden. He was a soldier during the war, which he bears heavy scars from.
        Lars-G\xF6ran frequently tries to distract his opponents by calling them
        names or telling dark jokes during the race.\r\n\r\nSpecial effects:\r\nAccustomed
        soldier\r\nLars-G\xF6ran is decent at everything.\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 7004382860810387237, guid: f00f41a79433ed04280b944953b51b56, type: 3}
      propertyPath: m_Name
      value: Text background p4
      objectReference: {fileID: 0}
    - target: {fileID: 7004382860810387237, guid: f00f41a79433ed04280b944953b51b56, type: 3}
      propertyPath: m_IsActive
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 8044037026975669814, guid: f00f41a79433ed04280b944953b51b56, type: 3}
      propertyPath: m_text
      value: "Andr\xE9 Nuskea, also called Drago\u0219 (by himself), was born in
        Tulcea, Romania. He tends to not listen to others and usually has a hard
        time connecting with anyone, even his family. Andr\xE9 was thrown out from
        home after not achieving anything but managed to get back on his feet by
        winning a huge amount of money from a lottery ticket. Now, he continues his
        life as a 25-year-old tank rally racer."
      objectReference: {fileID: 0}
    - target: {fileID: 8180816751454175232, guid: f00f41a79433ed04280b944953b51b56, type: 3}
      propertyPath: m_Name
      value: Tristano Martinelli description p4
      objectReference: {fileID: 0}
    - target: {fileID: 8239691013804413853, guid: f00f41a79433ed04280b944953b51b56, type: 3}
      propertyPath: m_Name
      value: "Andr\xE9 Nuskea description p4"
      objectReference: {fileID: 0}
    - target: {fileID: 8253676296214494490, guid: f00f41a79433ed04280b944953b51b56, type: 3}
      propertyPath: m_Name
      value: "Carla Cap\xF4 description p4"
      objectReference: {fileID: 0}
    - target: {fileID: 8630979208184768736, guid: f00f41a79433ed04280b944953b51b56, type: 3}
      propertyPath: m_text
      value: "Ragana Vilkaite was born in Ukmerg\xE9, Lithuania. Her childhood consisted
        of petty thefts and everything she considered fun, the feeling that she values
        more than anything else in life. Her life wasn\u2019t impacted by the third
        world war and at the age of 33 she began participating in tank rally races.
        Ragana always tries to approach other beings in a friendly manner which often
        ends up giving her the same treatment. \n"
      objectReference: {fileID: 0}
    - target: {fileID: 9103211324500983511, guid: f00f41a79433ed04280b944953b51b56, type: 3}
      propertyPath: m_text
      value: "Carla Cap\xF4 is a 28-year-old streamer from Faro, Portugal. She is
        a charismatic individual and frequently tells jokes, one of the many reasons
        why her fanbase stays loyal to her. Carla has a good connection with her
        viewers and often threatens opponents with sending her army on them, sometimes
        as a joke and sometimes as a serious warning. \r\n\r\nSpecial effects:\r\nHas
        a Shudder chat.\r\n"
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: f00f41a79433ed04280b944953b51b56, type: 3}
