--- !u!1001 &1838906031
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 8491925}
    m_Modifications:
    - target: {fileID: 857046901193993407, guid: f00f41a79433ed04280b944953b51b56, type: 3}
