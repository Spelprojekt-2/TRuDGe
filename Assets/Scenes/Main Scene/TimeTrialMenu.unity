    - target: {fileID: 3144206202189371698, guid: f00f41a79433ed04280b944953b51b56, type: 3}
      propertyPath: m_LocalRotation.x
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3144206202189371698, guid: f00f41a79433ed04280b944953b51b56, type: 3}
      propertyPath: m_LocalRotation.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3144206202189371698, guid: f00f41a79433ed04280b944953b51b56, type: 3}
      propertyPath: m_LocalRotation.z
      value: 0
