--- !u!1001 &1765071261
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 485456770}
    m_Modifications:
    - target: {fileID: 857046901193993407, guid: f00f41a79433ed04280b944953b51b56, type: 3}
      propertyPath: m_IsActive
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 2796228700513682423, guid: f00f41a79433ed04280b944953b51b56, type: 3}
      propertyPath: m_text
      value: "The 51-year-old Leonie Arenberg was born in Marburg, Germany. She got
        into racing at a very young age with help from her wealthy parents and managed
        to win a rally world championship in 2028. Leonie's calm attitude and financial
        support to the repair of Schlammrennstrecke makes her a well-known figure
        in racing. \r\n\r\nSpecial effects:\r\nCalm and methodical. \r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 3144206202189371698, guid: f00f41a79433ed04280b944953b51b56, type: 3}
      propertyPath: m_Pivot.x
      value: 0.5
      objectReference: {fileID: 0}
