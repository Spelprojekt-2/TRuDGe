      propertyPath: m_fontColor.g
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 6839170008172661114, guid: f00f41a79433ed04280b944953b51b56, type: 3}
      propertyPath: m_fontColor.r
      value: 0
      objectReference: {fileID: 0}
