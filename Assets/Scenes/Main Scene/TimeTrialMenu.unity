    - target: {fileID: 9103211324500983511, guid: f00f41a79433ed04280b944953b51b56, type: 3}
      propertyPath: m_text
      value: 'Carla Capo is a 28-year-old streamer from Faro, Portugal. She is a
        charismatic individual with a bubbly personality and usually brings her stream
        into the tank while racing.

        

        Special effects:

        Has
        a Shudder chat. '
      objectReference: {fileID: 0}
