--- !u!1001 &1537009337
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 881685241}
    m_Modifications:
    - target: {fileID: 857046901193993407, guid: f00f41a79433ed04280b944953b51b56, type: 3}
