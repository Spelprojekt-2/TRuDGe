      objectReference: {fileID: 0}
    - target: {fileID: 3379296185267970313, guid: f00f41a79433ed04280b944953b51b56, type: 3}
      propertyPath: m_Name
      value: King Napoleon III description p1
      objectReference: {fileID: 0}
    - target: {fileID: 3379296185267970313, guid: f00f41a79433ed04280b944953b51b56, type: 3}
      propertyPath: m_IsActive
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3659062856983726037, guid: f00f41a79433ed04280b944953b51b56, type: 3}
      propertyPath: m_text
      value: "The 36-year-old Tristano Martinelli from Tivoli, Italy, has loved performing
        as clowns ever since he was a young boy. He worked as a harlequin in commedia
        dell\u2019arte before the war, got drafted as a tank driver during the war
        and continues his performing career today, alongside his dank grifting hobby.
        Tristano brings his harlequin persona out to the track and exposes everyone
        to the true power (and comedy) of the harlequin!\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 3659062856983726037, guid: f00f41a79433ed04280b944953b51b56, type: 3}
      propertyPath: m_fontColor.b
